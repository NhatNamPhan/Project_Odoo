<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_quanly_datn">
        <field name="name">Quản Lý Đồ Án Tốt Nghiệp</field>
        <field name="description">Phân quyền người dùng trong Hệ thống Quản lý ĐATN Khoa Công nghệ số</field>
        <field name="sequence">10</field>
    </record>

    <!-- Nhóm Sinh viên -->
    <record id="group_datn_sinh_vien" model="res.groups">
        <field name="name">Sinh viên</field>
        <field name="category_id" ref="module_category_quanly_datn"/>
    </record>

    <!-- Nhóm Giảng viên -->
    <record id="group_datn_giang_vien" model="res.groups">
        <field name="name">Giảng viên (HD / PB / Hội đồng)</field>
        <field name="category_id" ref="module_category_quanly_datn"/>
    </record>

    <!-- Nhóm Ban Chủ nhiệm Khoa / Trợ lý Giáo vụ (Admin) -->
    <record id="group_datn_ban_chu_nhiem" model="res.groups">
        <field name="name">Ban Chủ nhiệm Khoa / Giáo vụ</field>
        <field name="category_id" ref="module_category_quanly_datn"/>
        <field name="implied_ids" eval="[(4, ref('group_datn_giang_vien'))]"/>
    </record>
</odoo>
