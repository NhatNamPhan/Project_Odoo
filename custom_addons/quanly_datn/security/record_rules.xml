<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BCN manages every record. As this group implies the lecturer group, this rule
         also ensures its members are not constrained by lecturer-specific rules. -->
    <record id="rule_bcn_all_dangky" model="ir.rule"><field name="name">BCN: all registrations</field><field name="model_id" ref="model_quanly_dangky"/><field name="groups" eval="[(4, ref('group_datn_ban_chu_nhiem'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_bcn_all_nganhang" model="ir.rule"><field name="name">BCN: all topic proposals</field><field name="model_id" ref="model_quanly_nganhangdetai"/><field name="groups" eval="[(4, ref('group_datn_ban_chu_nhiem'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_bcn_all_detai" model="ir.rule"><field name="name">BCN: all theses</field><field name="model_id" ref="model_quanly_detai"/><field name="groups" eval="[(4, ref('group_datn_ban_chu_nhiem'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_bcn_all_hinhanh" model="ir.rule"><field name="name">BCN: all thesis images</field><field name="model_id" ref="model_quanly_hinhanhdetai"/><field name="groups" eval="[(4, ref('group_datn_ban_chu_nhiem'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_bcn_all_baocao" model="ir.rule"><field name="name">BCN: all reports</field><field name="model_id" ref="model_quanly_baocao"/><field name="groups" eval="[(4, ref('group_datn_ban_chu_nhiem'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_bcn_all_phieu" model="ir.rule"><field name="name">BCN: all score sheets</field><field name="model_id" ref="model_quanly_phieuchamdiem"/><field name="groups" eval="[(4, ref('group_datn_ban_chu_nhiem'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
    <record id="rule_bcn_all_tinnhan" model="ir.rule"><field name="name">BCN: all messages</field><field name="model_id" ref="model_quanly_tinnhan"/><field name="groups" eval="[(4, ref('group_datn_ban_chu_nhiem'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>

    <!-- Students only access records that belong to their own profile or thesis. -->
    <record id="rule_sv_own_profile" model="ir.rule"><field name="name">Student: own profile</field><field name="model_id" ref="model_quanly_sinhvien"/><field name="groups" eval="[(4, ref('group_datn_sinh_vien'))]"/><field name="domain_force">[('user_id', '=', user.id)]</field></record>
    <record id="rule_sv_own_dangky" model="ir.rule"><field name="name">Student: own registrations</field><field name="model_id" ref="model_quanly_dangky"/><field name="groups" eval="[(4, ref('group_datn_sinh_vien'))]"/><field name="domain_force">[('sinh_vien_id.user_id', '=', user.id)]</field></record>
    <record id="rule_sv_own_detai" model="ir.rule"><field name="name">Student: own thesis</field><field name="model_id" ref="model_quanly_detai"/><field name="groups" eval="[(4, ref('group_datn_sinh_vien'))]"/><field name="domain_force">[('sinh_vien_id.user_id', '=', user.id)]</field></record>
    <record id="rule_sv_own_hinhanh" model="ir.rule"><field name="name">Student: own thesis images</field><field name="model_id" ref="model_quanly_hinhanhdetai"/><field name="groups" eval="[(4, ref('group_datn_sinh_vien'))]"/><field name="domain_force">[('de_tai_id.sinh_vien_id.user_id', '=', user.id)]</field></record>
    <record id="rule_sv_own_baocao" model="ir.rule"><field name="name">Student: own reports</field><field name="model_id" ref="model_quanly_baocao"/><field name="groups" eval="[(4, ref('group_datn_sinh_vien'))]"/><field name="domain_force">[('de_tai_id.sinh_vien_id.user_id', '=', user.id)]</field></record>
    <record id="rule_sv_own_phieu" model="ir.rule"><field name="name">Student: own score sheets</field><field name="model_id" ref="model_quanly_phieuchamdiem"/><field name="groups" eval="[(4, ref('group_datn_sinh_vien'))]"/><field name="domain_force">[('de_tai_id.sinh_vien_id.user_id', '=', user.id)]</field><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
    <record id="rule_sv_own_tinnhan" model="ir.rule"><field name="name">Student: own thesis messages</field><field name="model_id" ref="model_quanly_tinnhan"/><field name="groups" eval="[(4, ref('group_datn_sinh_vien'))]"/><field name="domain_force">[('de_tai_id.sinh_vien_id.user_id', '=', user.id)]</field></record>

    <!-- Lecturers are limited to their profile, supervised theses and assigned score sheets. -->
    <record id="rule_gv_own_profile" model="ir.rule"><field name="name">Lecturer: own profile</field><field name="model_id" ref="model_quanly_giangvien"/><field name="groups" eval="[(4, ref('group_datn_giang_vien'))]"/><field name="domain_force">[('user_id', '=', user.id)]</field></record>
    <record id="rule_gv_assigned_detai" model="ir.rule"><field name="name">Lecturer: supervised or council thesis</field><field name="model_id" ref="model_quanly_detai"/><field name="groups" eval="[(4, ref('group_datn_giang_vien'))]"/><field name="domain_force">['|', ('giang_vien_huong_dan_id.user_id', '=', user.id), ('hoi_dong_id.thanh_vien_ids.giang_vien_id.user_id', '=', user.id)]</field></record>
    <record id="rule_gv_supervised_hinhanh" model="ir.rule"><field name="name">Lecturer: supervised thesis images</field><field name="model_id" ref="model_quanly_hinhanhdetai"/><field name="groups" eval="[(4, ref('group_datn_giang_vien'))]"/><field name="domain_force">[('de_tai_id.giang_vien_huong_dan_id.user_id', '=', user.id)]</field></record>
    <record id="rule_gv_supervised_baocao" model="ir.rule"><field name="name">Lecturer: supervised reports</field><field name="model_id" ref="model_quanly_baocao"/><field name="groups" eval="[(4, ref('group_datn_giang_vien'))]"/><field name="domain_force">[('de_tai_id.giang_vien_huong_dan_id.user_id', '=', user.id)]</field></record>
    <record id="rule_gv_own_phieu" model="ir.rule"><field name="name">Lecturer: own score sheets</field><field name="model_id" ref="model_quanly_phieuchamdiem"/><field name="groups" eval="[(4, ref('group_datn_giang_vien'))]"/><field name="domain_force">[('hoi_dong_giang_vien_id.giang_vien_id.user_id', '=', user.id)]</field></record>
    <record id="rule_gv_assigned_tinnhan" model="ir.rule"><field name="name">Lecturer: supervised thesis messages</field><field name="model_id" ref="model_quanly_tinnhan"/><field name="groups" eval="[(4, ref('group_datn_giang_vien'))]"/><field name="domain_force">[('de_tai_id.giang_vien_huong_dan_id.user_id', '=', user.id)]</field></record>
</odoo>
