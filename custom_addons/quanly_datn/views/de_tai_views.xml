<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Đề tài chính thức -->
    <record id="view_detai_tree" model="ir.ui.view">
        <field name="name">quanly.detai.list</field>
        <field name="model">quanly.detai</field>
        <field name="arch" type="xml">
            <list string="Danh sách đề tài">
                <field name="ma_de_tai"/>
                <field name="ten_de_tai"/>
                <field name="sinh_vien_id"/>
                <field name="giang_vien_huong_dan_id"/>
                <field name="dot_do_an_id"/>
                <field name="hoi_dong_id"/>
                <field name="diem_tong_ket"/>
                <field name="xep_loai"/>
                <field name="trang_thai"/>
            </list>
        </field>
    </record>

    <record id="view_detai_form" model="ir.ui.view">
        <field name="name">quanly.detai.form</field>
        <field name="model">quanly.detai</field>
        <field name="arch" type="xml">
            <form string="Đề tài tốt nghiệp">
                <header>
                    <field name="trang_thai" widget="statusbar" statusbar_visible="dang_thuc_hien,cho_bao_ve,da_bao_ve,da_luu_chieu"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="ma_de_tai" string="Mã đề tài"/>
                        <h1>
                            <field name="ma_de_tai" placeholder="VD: DT2026_01"/>
                        </h1>
                        <label for="ten_de_tai" string="Tên đề tài"/>
                        <h2>
                            <field name="ten_de_tai" placeholder="Tên đề tài đồ án tốt nghiệp..."/>
                        </h2>
                    </div>
                    <group>
                        <group string="Phân công">
                            <field name="dang_ky_id"/>
                            <field name="sinh_vien_id"/>
                            <field name="giang_vien_huong_dan_id"/>
                            <field name="dot_do_an_id"/>
                        </group>
                        <group string="Hội đồng &amp; Kết quả">
                            <field name="hoi_dong_id"/>
                            <field name="gvhd_da_duyet"/>
                            <field name="diem_gvhd"/>
                            <field name="diem_bao_cao_tb"/>
                            <field name="diem_do_an_tb"/>
                            <field name="diem_tong_ket"/>
                            <field name="xep_loai"/>
                            <field name="da_khoa_diem"/>
                        </group>
                    </group>
                    <group string="Đường dẫn liên kết">
                        <group>
                            <field name="link_github" widget="url"/>
                        </group>
                        <group>
                            <field name="link_demo" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nội dung mô tả đề tài">
                            <field name="mo_ta" placeholder="Mô tả chi tiết nội dung, kiến trúc, công nghệ..."/>
                        </page>
                        <page string="Tiến độ Báo cáo định kỳ">
                            <field name="bao_cao_ids"/>
                        </page>
                        <page string="Hình ảnh Demo / Showcase sản phẩm (Lưu chiểu)">
                            <field name="hinh_anh_ids">
                                <list>
                                    <field name="ten_hinh"/>
                                    <field name="hinh_anh" widget="image" options="{'size': [64, 64]}"/>
                                    <field name="mo_ta"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="ten_hinh"/>
                                        <field name="hinh_anh" widget="image"/>
                                        <field name="url"/>
                                        <field name="mo_ta"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Phiếu chấm điểm Hội đồng">
                            <field name="phieu_cham_diem_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_detai" model="ir.actions.act_window">
        <field name="name">Đề tài tốt nghiệp</field>
        <field name="res_model">quanly.detai</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Thư viện hình ảnh đề tài -->
    <record id="view_hinhanhdetai_tree" model="ir.ui.view">
        <field name="name">quanly.hinhanhdetai.list</field>
        <field name="model">quanly.hinhanhdetai</field>
        <field name="arch" type="xml">
            <list string="Hình ảnh sản phẩm">
                <field name="de_tai_id"/>
                <field name="ten_hinh"/>
                <field name="hinh_anh" widget="image" options="{'size': [50, 50]}"/>
                <field name="mo_ta"/>
            </list>
        </field>
    </record>

    <record id="action_hinhanhdetai" model="ir.actions.act_window">
        <field name="name">Thư viện ảnh sản phẩm đề tài</field>
        <field name="res_model">quanly.hinhanhdetai</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_detai" name="Đề tài tốt nghiệp" parent="menu_sub_de_tai_root" action="action_detai" sequence="10"/>
    <menuitem id="menu_hinhanhdetai" name="Thư viện ảnh Showcase" parent="menu_sub_de_tai_root" action="action_hinhanhdetai" sequence="20"/>
</odoo>

